{
  "name": "review2",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-agnostic CriticMarkup review pipeline core.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/colony-2/review2.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:demo": "vite build demo --outDir ../dist-demo --emptyOutDir",
    "clean": "rm -rf dist",
    "dev": "vite demo --host 0.0.0.0",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright test",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.7"
  },
  "dependencies": {
    "@lexical/code": "^0.46.0",
    "@lexical/history": "^0.46.0",
    "@lexical/link": "^0.46.0",
    "@lexical/list": "^0.46.0",
    "@lexical/markdown": "^0.46.0",
    "@lexical/rich-text": "^0.46.0",
    "@lexical/selection": "^0.46.0",
    "@lexical/utils": "^0.46.0",
    "lexical": "^0.46.0"
  }
}
