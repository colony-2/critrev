{
  "name": "critrev",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Unstyled React review editor and framework-independent Markdown diff, suggestions, and comments.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/colony-2/critrev.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./lexical": {
      "types": "./dist/lexical/index.d.ts",
      "import": "./dist/lexical/index.js",
      "default": "./dist/lexical/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "build:demo": "vite build demo --config vite.config.ts --outDir ../dist-demo --emptyOutDir",
    "clean": "rm -rf dist",
    "dev": "vite demo --host 0.0.0.0",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright test",
    "test": "tsc -p tsconfig.test.json && node --test \".test-dist/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "prepack": "npm run build",
    "check:package": "npm run build && node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.7"
  },
  "dependencies": {
    "@lexical/code-core": "^0.46.0",
    "@lexical/history": "^0.46.0",
    "@lexical/link": "^0.46.0",
    "@lexical/list": "^0.46.0",
    "@lexical/markdown": "^0.46.0",
    "@lexical/rich-text": "^0.46.0",
    "@lexical/selection": "^0.46.0",
    "@lexical/utils": "^0.46.0",
    "lexical": "^0.46.0",
    "@lexical/extension": "^0.46.0"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/colony-2/critrev#readme",
  "bugs": {
    "url": "https://github.com/colony-2/critrev/issues"
  },
  "keywords": [
    "react",
    "markdown",
    "criticmarkup",
    "diff",
    "review",
    "editor"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
