{
  "name": "review2",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-agnostic CriticMarkup review pipeline core.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/colony-2/review2.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^5.9.0"
  }
}
