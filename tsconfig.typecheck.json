  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "rootDir": "."
  },
  "include": [
    "src/**/*.ts",
    "demo/src/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts"
  ]
}
