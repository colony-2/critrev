{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "rootDir": ".",
    "paths": {
      "critrev": [
        "./src/index.ts"
      ],
      "critrev/react": [
        "./src/react/index.ts"
      ],
      "critrev/lexical": [
        "./src/lexical/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "demo/src/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts",
    "src/**/*.tsx",
    "demo/src/**/*.tsx",
    "vite.config.ts"
  ],
  "exclude": []
}
